{
  "name": "@dtkt/protoform",
  "version": "0.1.0",
  "description": "DataKit Protoform",
  "license": "Apache-2.0",
  "keywords": [
    "datakit",
    "dtkt",
    "protobuf",
    "protoform",
    "react",
    "forms"
  ],
  "homepage": "https://github.com/datakit-dev/protoform-es",
  "bugs": {
    "url": "https://github.com/datakit-dev/protoform-es/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datakit-dev/protoform-es.git"
  },
  "type": "module",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js"
    },
    "./kit/tailwind": {
      "types": "./dist/kit/tailwind/index.d.ts",
      "import": "./dist/kit/tailwind/index.js"
    },
    "./gen/*.js": {
      "types": "./dist/gen/*.d.ts",
      "import": "./dist/gen/*.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:css",
    "build:css": "tailwindcss -i lib/styles/protoform.css -o dist/styles.css --minify",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "gen": "buf generate",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@headlessui/react": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@headlessui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@buf/datakit-dev_dtkt-sdk.bufbuild_es": "^2.16.0-20261027090458-7143679e943c.1",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@headlessui/react": "^2.2.10",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0"
  },
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components/index.d.ts"
      ],
      "providers": [
        "./dist/providers/index.d.ts"
      ],
      "kit": [
        "./dist/kit/index.d.ts"
      ],
      "kit/tailwind": [
        "./dist/kit/tailwind/index.d.ts"
      ],
      "gen/*.js": [
        "./dist/gen/*.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
